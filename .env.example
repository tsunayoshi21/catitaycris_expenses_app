# PostgreSQL
POSTGRES_DB=finanzas
POSTGRES_USER=finanzas_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django
SECRET_KEY=change_me_generate_with_python_-c_import_secrets_print_secrets.token_hex_50
DJANGO_SETTINGS_MODULE=finanzas.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS (frontend origin)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username_without_at

# OpenAI / LLM
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Fernet encryption key for IMAP credentials
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=your_fernet_key_here

# Admin user (created on first startup)
ADMIN_USERNAME=titino
ADMIN_PASSWORD=titino123
ADMIN_TELEGRAM_CHAT_ID=
ADMIN_IMAP_EMAIL=
ADMIN_IMAP_PASSWORD=
ADMIN_IMAP_START_DATE=          # formato YYYY-MM-DD, desde cuándo leer emails (default: hoy)

# Bank email senders (comma-separated, lowercase)
BANK_SENDERS=enviodigital@bancochile.cl,serviciodetransferencias@bancochile.cl

# IMAP configuration
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_FOLDER=INBOX

# Email polling interval in seconds
POLL_INTERVAL=60
